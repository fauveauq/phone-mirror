<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PhoneMirror</RootNamespace>
    <AssemblyName>PhoneMirror</AssemblyName>
    <Version>1.3.0</Version>
    <!-- Main personnalisé (Program.cs) pour initialiser Velopack avant WPF. -->
    <StartupObject>PhoneMirror.Program</StartupObject>
    <!-- Icône générée par Assets\make-icon.ps1 -->
    <ApplicationIcon>Assets\PhoneMirror.ico</ApplicationIcon>
    <Product>Phone Mirror</Product>
    <Description>Recopie et contrôle de l'écran d'un téléphone Android en USB</Description>
  </PropertyGroup>

  <!-- Avec WPF, les usings implicites n'incluent pas System.IO. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="PhoneMirror.Tests" />
  </ItemGroup>

  <!-- Le projet de tests et l'installeur ont leurs propres fichiers. -->
  <ItemGroup>
    <Compile Remove="tests\**;installer\**" />
    <None Remove="tests\**;installer\**" />
    <Page Remove="tests\**;installer\**" />
  </ItemGroup>

  <!-- La version du paquet doit correspondre à la version des DLL FFmpeg
       placées dans third_party\ffmpeg (ici FFmpeg 9.0.1). -->
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="9.0.1.1" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="9.0.1.1" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Icône des fenêtres (barre de titre, Alt+Tab). -->
  <ItemGroup>
    <Resource Include="Assets\PhoneMirror.ico" />
  </ItemGroup>

  <!-- adb, serveur scrcpy et DLL FFmpeg copiés à côté de l'exécutable. -->
  <ItemGroup>
    <None Include="third_party\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
