<Window x:Class="PhoneMirror.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourcis — Phone Mirror"
        Icon="/Assets/PhoneMirror.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF1B1D22">
    <StackPanel Margin="24,20,24,20">
        <!-- Rempli par le code à partir de ShortcutCatalog -->
        <StackPanel x:Name="GroupsPanel" />
        <Button Content="Fermer" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                Margin="0,18,0,0" Padding="16,6" MinWidth="90" Click="OnCloseClick" />
    </StackPanel>
</Window>
